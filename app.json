{
  "expo": {
    "name": "Frutou",
    "slug": "frutou",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Frutou usa suas fotos para você escolher uma imagem de perfil."
        }
      ]
    ]
  }
}
