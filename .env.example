# Copie para .env e ajuste. O Expo injeta variáveis EXPO_PUBLIC_* automaticamente.
#
# --- Desenvolvimento (Expo Go / expo start) ---
# Use o IP da sua máquina na rede local (NÃO "localhost" — o celular não alcança).
# Descubra com:  ip addr | grep 'inet '   (Linux)  /  ipconfig getifaddr en0 (macOS)
# Para testar só no navegador (expo start --web), pode usar http://localhost:3333
EXPO_PUBLIC_API_URL=http://192.168.0.8:3333

# --- Build de distribuição (eas build) ---
# O valor abaixo é "congelado" dentro do APK. Para o app funcionar em qualquer
# rede/celular, aponte para o backend hospedado (ver docs/backend-deploy-render.md).
# Sem barra no final.
# EXPO_PUBLIC_API_URL=https://frutou-api.onrender.com
